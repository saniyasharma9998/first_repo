# Food Delivery Analytics — Environment Variables
# Copy this file to .env and fill in any values needed for your environment.
# The project runs fully without any environment variables — this file is provided
# for optional configuration.

# ── Streamlit server port (optional, default: 8501) ──────────────────────────
# STREAMLIT_SERVER_PORT=8501

# ── Data paths (optional — defaults are relative to project root) ─────────────
# RAW_DATA_PATH=data/raw/food_delivery_orders.csv
# PROCESSED_DATA_PATH=data/processed/cleaned_food_delivery_orders.csv

# ── Random seed for data generation (optional, default: 42) ──────────────────
# RANDOM_SEED=42
